# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anonymous key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres URL used by database integration tests.
SUPABASE_DB_URL=
# Server-only Stripe secret key.
STRIPE_SECRET_KEY=
# Server-only Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Public Stripe publishable key for browser integrations.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only Pestora lead ingestion secret.
PESTORA_INGESTION_SECRET=
# Server-only Drenora lead ingestion secret.
DRENORA_INGESTION_SECRET=
# Server-only Movira lead ingestion secret.
MOVIRA_INGESTION_SECRET=
# Public application base URL for Stripe redirects.
NEXT_PUBLIC_APP_URL=
# Local-only password for the seeded admin browser user.
SEED_ADMIN_PASSWORD=
# Local-only password for the seeded partner browser user.
SEED_PARTNER_PASSWORD=
# Optional override for the seeded admin email.
SEED_ADMIN_EMAIL=
# Optional override for the seeded partner email.
SEED_PARTNER_EMAIL=
